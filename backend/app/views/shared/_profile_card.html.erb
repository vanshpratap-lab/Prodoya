<div class="profile-header">
  <div class="avatar"><%= user.full_name[0].upcase %></div>
  <div>
    <h1><%= user.full_name %></h1>
    <div class="role">@<%= user.username %><%= user.role.presence ? " · #{user.role}" : "" %></div>
    <div class="role"><%= user.college.presence || "Engineer" %> · <%= connection_count %> connections</div>
    <% if user.bio.present? %><p style="font-size:0.9rem;"><%= h(user.bio) %></p><% end %>
    <div class="profile-links">
      <span class="points-badge"><%= user.points %> points</span>
      <% if user.github_url.present? %><%= link_to "GitHub", user.github_url, target: "_blank", rel: "noopener" %><% end %>
      <% if user_signed_in? %>
        <%= link_to "Chat", channels_path %>
      <% end %>
    </div>
  </div>
  <% if user_signed_in? && !current %>
    <% if current_user.connected_to?(user) %>
      <%= button_to "Disconnect", disconnect_user_path(user), method: :delete, class: "btn btn-sm" %>
    <% else %>
      <%= button_to "Connect", connect_user_path(user), method: :post, class: "btn btn-primary btn-sm" %>
    <% end %>
  <% end %>
</div>