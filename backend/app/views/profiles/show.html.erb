<% content_for :title, "#{@user.full_name} — Prodoya" %>
<div class="navbar" style="justify-content:space-between;">
  <%= link_to "Prodoya", root_path, class: "brand" %>
  <div class="nav-user">
    <% if user_signed_in? %>
      <%= link_to "Feed", root_path %>
      <%= link_to current_user.full_name, user_path(current_user) %>
    <% else %>
      <%= link_to "Sign in", new_user_session_path, class: "btn btn-sm" %>
    <% end %>
  </div>
</div>
<div class="container">
  <%= render "shared/profile_card", user: @user, connection_count: @connection_count, current: false %>

  <h3>Posts</h3>
  <% if @posts.any? %>
    <% @posts.each do |post| %>
      <div class="post">
        <div class="post-content"><%= simple_format(h(post.content)) %></div>
        <div class="difficulty-badge difficulty-<%= post.difficulty %>"><%= post.difficulty %></div>
        <div class="post-meta"><%= time_ago_in_words(post.created_at) %> ago · <%= post.post_likes.count %> likes</div>
        <% if user_signed_in? %>
          <div class="mt-2"><%= link_to "View in feed", root_path, class: "action-btn" %></div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="empty">No public posts yet.</div>
  <% end %>
</div>